{
    "AllowedHosts":  "api.example.com",
    "ConnectionStrings":  {
                              "Default":  "Server=YOUR_SQL_SERVER;Database=ECommerceDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=False;Encrypt=True;"
                          },
    "Jwt":  {
                "Key":  "replace-with-at-least-32-bytes-from-a-secret-store",
                "Issuer":  "ECommerceBackend",
                "Audience":  "your-api-client",
                "AccessTokenMinutes":  60,
                "RefreshTokenDays":  7
            },
    "ReverseProxy":  {
                          "Enabled":  true,
                          "ForwardLimit":  1,
                          "RequireHeaderSymmetry":  true,
                          "KnownProxies":  [
                                                "10.0.0.10"
                                            ],
                          "KnownNetworks":  []
                      },
    "DataProtection":  {
                            "ApplicationName":  "ECommerceBackend",
                            "KeysPath":  "C:\\ECommerceBackend\\DataProtectionKeys"
                        },
    "AdminBootstrap":  {
                           "Enabled":  false
                       },
    "PaymentWebhooks":  {
                            "GenericHmac":  {
                                                "Enabled":  false,
                                                "ProviderCode":  "generic-hmac",
                                                "Secret":  "replace-with-at-least-32-bytes-from-a-secret-store",
                                                "MaxPayloadBytes":  65536,
                                                "MaxFutureSkewMinutes":  5
                                            }
                        },
    "Outbox":  {
                   "Enabled":  true,
                   "PollIntervalSeconds":  5,
                   "BatchSize":  20,
                   "MaxAttempts":  5,
                   "LockTimeoutMinutes":  5,
                   "ProcessingTimeoutSeconds":  60,
                   "MaxPendingAgeMinutes":  15
               },
    "OrderLifecycle":  {
                             "PendingCodHoldMinutes":  30,
                             "MaxPendingOrdersPerCustomer":  3,
                             "ExpirationEnabled":  true,
                             "ExpirationDryRun":  true,
                             "ExpirationPollIntervalSeconds":  30,
                             "ExpirationBatchSize":  50,
                             "MaxOverdueMinutes":  15
                         },
    "Notifications":  {
                          "Smtp":  {
                                       "Enabled":  true,
                                       "Host":  "smtp.example.com",
                                       "Port":  587,
                                       "EnableSsl":  true,
                                       "UserName":  "",
                                       "Password":  "",
                                       "FromAddress":  "no-reply@example.com",
                                       "FromName":  "ECommerceBackend",
                                       "TimeoutSeconds":  30
                                   }
                      },
    "Cors":  {
                 "AllowedOrigins":  [
                                        "https://your-frontend.example.com"
                                    ]
             },
    "Uploads":  {
                    "MaxImageSizeBytes":  5242880,
                    "ReconciliationGraceMinutes":  60,
                    "MaxReconciliationDeletes":  100
                },
    "AutoMapper":  {
                       "LicenseKey":  "optional-license-key-from-secret-store"
                   },
    "Swagger":  {
                    "Enabled":  false
                },
    "Serilog":  {
                    "MinimumLevel":  "Information"
                }
}
