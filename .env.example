# Local Docker Compose values only. Replace these before sharing an environment.
MSSQL_SA_PASSWORD=change-me-LocalSql-2026!
JWT_KEY=change-me-local-jwt-signing-key-at-least-32-bytes
HOST_BIND_ADDRESS=127.0.0.1
API_PORT=5171
SQLSERVER_PORT=1433
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Optional one-time local admin bootstrap. Keep disabled after the first start.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_FULL_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
