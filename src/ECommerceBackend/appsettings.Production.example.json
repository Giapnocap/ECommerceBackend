{
    "AllowedHosts":  "api.example.com",
    "ConnectionStrings":  {
                              "Default":  "Server=YOUR_SQL_SERVER;Database=ECommerceDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=False;Encrypt=True;"
                          },
    "Database":  {
                     "CommandTimeoutSeconds":  30
                 },
    "HealthChecks":  {
                         "DependencyTimeoutSeconds":  5
                     },
    "DataRetention":  {
                          "Enabled":  false,
                          "AutomaticProcessingEnabled":  false,
                          "RequireAutomaticProcessing":  false,
                          "ProcessedOutboxRetentionDays":  30,
                          "ExpiredRefreshTokenRetentionDays":  30,
                          "WebhookPayloadRetentionDays":  30,
                          "MaxBatchSize":  100,
                          "ProcessingIntervalMinutes":  1440,
                          "FailureRetryMinutes":  5,
                          "MaxBatchesPerCycle":  10
                      },
    "Jwt":  {
                "Key":  "replace-with-at-least-32-bytes-from-a-secret-store",
                "Issuer":  "ECommerceBackend",
                "Audience":  "your-api-client",
                "AccessTokenMinutes":  60,
                "RefreshTokenDays":  7
            },
    "AuthSecurity":  {
                         "MaxFailedLoginAttempts":  5,
                         "LockoutMinutes":  15,
                         "PasswordResetTokenMinutes":  30,
                         "PasswordResetUrl":  "https://your-frontend.example.com/reset-password",
                         "EmailVerificationTokenMinutes":  1440,
                         "EmailVerificationUrl":  "https://your-frontend.example.com/verify-email"
                     },
    "ReverseProxy":  {
                          "Enabled":  true,
                          "ForwardLimit":  1,
                          "RequireHeaderSymmetry":  true,
                          "KnownProxies":  [
                                                "10.0.0.10"
                                            ],
                          "KnownNetworks":  []
                      },
    "RateLimiting":  {
                          "Auth":  { "PermitLimit":  10, "WindowSeconds":  60 },
                          "Refresh":  { "PermitLimit":  30, "WindowSeconds":  60 },
                          "Upload":  { "PermitLimit":  20, "WindowSeconds":  60 },
                          "Webhook":  { "PermitLimit":  120, "WindowSeconds":  60 },
                          "Checkout":  { "PermitLimit":  5, "WindowSeconds":  60 }
                      },
    "DataProtection":  {
                            "ApplicationName":  "ECommerceBackend",
                            "KeysPath":  "C:\\ECommerceBackend\\DataProtectionKeys"
                        },
    "AdminBootstrap":  {
                           "Enabled":  false
                       },
    "PaymentWebhooks":  {
                            "GenericHmac":  {
                                                "Enabled":  false,
                                                "ProviderCode":  "generic-hmac",
                                                "Secret":  "",
                                                "MaxPayloadBytes":  65536,
                                                "MaxFutureSkewMinutes":  5,
                                                "RetainRawPayload":  false
                                            }
                        },
    "Payments":  {
                     "Stripe":  {
                                    "Enabled":  false,
                                    "BaseUrl":  "https://api.stripe.com/",
                                    "SecretKey":  "",
                                    "PublishableKey":  "",
                                    "WebhookSecret":  "",
                                    "RequestTimeoutSeconds":  15,
                                    "CreationLeaseSeconds":  120,
                                    "WebhookToleranceSeconds":  300,
                                    "ReconciliationEnabled":  false,
                                    "RequireReconciliation":  false,
                                    "ReconciliationPollIntervalSeconds":  60,
                                    "ReconciliationStaleAfterMinutes":  5,
                                    "ReconciliationBatchSize":  50
                                }
                 },
    "Outbox":  {
                   "Enabled":  true,
                   "RequireProcessing":  true,
                   "PollIntervalSeconds":  5,
                   "BatchSize":  20,
                   "MaxAttempts":  5,
                   "LockTimeoutMinutes":  5,
                   "ProcessingTimeoutSeconds":  60,
                   "MaxPendingAgeMinutes":  15
               },
    "OrderLifecycle":  {
                             "PendingCodHoldMinutes":  30,
                             "MaxPendingOrdersPerCustomer":  3,
                             "RequireExpirationProcessing":  true,
                             "ExpirationEnabled":  true,
                             "ExpirationDryRun":  false,
                             "ExpirationPollIntervalSeconds":  30,
                             "ExpirationBatchSize":  50,
                             "MaxOverdueMinutes":  15
                         },
    "Pricing":  {
                    "Currency":  "VND",
                    "SupportedCurrencies":  [ "VND" ],
                    "ExchangeRates":  {
                                           "Enabled":  false,
                                           "BaseUrl":  "https://api.currencyapi.com/",
                                           "ApiKey":  "",
                                           "RequestTimeoutSeconds":  10,
                                           "CacheMinutes":  60,
                                           "MaxStaleMinutes":  1440
                                       },
                    "QuoteValidityMinutes":  5,
                    "StandardShippingFee":  30000,
                    "ExpressShippingFee":  60000,
                    "FreeStandardShippingMinimum":  1000000,
                    "TaxRatePercent":  0
                },
    "Returns":  {
                    "ReturnWindowDays":  14
                },
    "Notifications":  {
                          "Smtp":  {
                                       "Enabled":  true,
                                       "Host":  "smtp.example.com",
                                       "Port":  587,
                                       "EnableSsl":  true,
                                       "UserName":  "",
                                       "Password":  "",
                                       "FromAddress":  "no-reply@example.com",
                                       "FromName":  "ECommerceBackend",
                                       "TimeoutSeconds":  30
                                   }
                      },
    "Cors":  {
                 "AllowedOrigins":  [
                                        "https://your-frontend.example.com"
                                    ]
             },
    "Uploads":  {
                    "MaxImageSizeBytes":  5242880,
                    "ReconciliationGraceMinutes":  60,
                    "MaxReconciliationDeletes":  100
                },
    "Swagger":  {
                    "Enabled":  false
                },
    "Observability":  {
                            "Enabled":  true,
                            "ServiceName":  "ECommerceBackend",
                            "TraceSamplingRatio":  0.1,
                            "Otlp":  {
                                         "Enabled":  false,
                                         "Endpoint":  "http://localhost:4317"
                                     }
                        },
    "Serilog":  {
                    "MinimumLevel":  "Information"
                }
}
