@BaseUrl = http://localhost:5171
@ApiBase = {{BaseUrl}}/api/v1
@AdminPassword = replace-with-local-admin-password
@StaffPassword = replace-with-local-staff-password
@CustomerPassword = replace-with-local-customer-password

# Update these values from responses when your HTTP client does not support named-response variables.
@AdminToken =
@AdminRefreshToken =
@StaffToken =
@CustomerToken =
@CustomerRefreshToken =
@CategoryId =
@ProductId =
@ProductVersion =
@ProductImageId =
@CartItemId =
@OrderId =
@OnlineOrderId =
@PromotionId =
@UserId =
@IdempotencyKey = checkout-demo-001
@PaymentProvider = generic-hmac
@PaymentEventId = replace-with-provider-event-id
@PaymentSignature = replace-with-hex-hmac-signature

### Swagger JSON
GET {{BaseUrl}}/swagger/v1/swagger.json
Accept: application/json

### Health - live
GET {{BaseUrl}}/health/live
Accept: application/json

### Health - ready
GET {{BaseUrl}}/health/ready
Accept: application/json

### Health - all checks
GET {{BaseUrl}}/health
Accept: application/json

### Admin login
# @name adminLogin
POST {{ApiBase}}/auth/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "{{AdminPassword}}"
}

### Staff login - after running SeedDemoData.sql
# @name staffLogin
POST {{ApiBase}}/auth/login
Content-Type: application/json

{
  "userName": "demo.staff",
  "password": "{{StaffPassword}}"
}

### Admin profile
GET {{ApiBase}}/users/me
Accept: application/json
Authorization: Bearer {{AdminToken}}

### List users - Admin
GET {{ApiBase}}/users?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{AdminToken}}

### Assign role - Admin
PUT {{ApiBase}}/users/{{UserId}}/role
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "roleName": "Staff"
}

### Create category - Admin
# @name createCategory
POST {{ApiBase}}/categories
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "name": "Demo Category",
  "parentId": null
}

### List categories
GET {{ApiBase}}/categories
Accept: application/json

### Get category by id
GET {{ApiBase}}/categories/{{CategoryId}}
Accept: application/json

### Create product - Admin
# @name createProduct
POST {{ApiBase}}/products
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "name": "Demo Product",
  "price": 599000.00,
  "stockQuantity": 10,
  "description": "Demo product for the HTTP request collection.",
  "categoryId": "{{CategoryId}}"
}

### List products with filter/sort/page
GET {{ApiBase}}/products?keyword=Demo&sortBy=price&sortOrder=asc&page=1&pageSize=12
Accept: application/json

### List product summaries with filter/sort/page
GET {{ApiBase}}/products/summaries?keyword=Demo&sortBy=price&sortOrder=asc&page=1&pageSize=12
Accept: application/json

### Get product by id
GET {{ApiBase}}/products/{{ProductId}}
Accept: application/json

### Update product - Admin
PUT {{ApiBase}}/products/{{ProductId}}
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "name": "Demo Product Updated",
  "price": 609000.00,
  "stockQuantity": 10,
  "description": "Updated demo product for the HTTP request collection.",
  "categoryId": "{{CategoryId}}"
}

### Adjust product stock - Admin
PUT {{ApiBase}}/products/{{ProductId}}/stock
Content-Type: application/json
Authorization: Bearer {{AdminToken}}
If-Match: "{{ProductVersion}}"

{
  "targetQuantity": 12,
  "reason": "Manual inventory count"
}

### Upload product image - Admin
# Replace ./sample-product.jpg with a real local image path before sending.
POST {{ApiBase}}/products/{{ProductId}}/images?isMain=true
Authorization: Bearer {{AdminToken}}
Content-Type: multipart/form-data; boundary=BoundaryDemoProduct

--BoundaryDemoProduct
Content-Disposition: form-data; name="file"; filename="sample-product.jpg"
Content-Type: image/jpeg

< ./sample-product.jpg
--BoundaryDemoProduct--

### Register customer
# Change userName/email when re-running after the user already exists.
# @name registerCustomer
POST {{ApiBase}}/auth/register
Content-Type: application/json

{
  "userName": "demo_customer",
  "email": "demo_customer@example.com",
  "password": "{{CustomerPassword}}",
  "fullName": "Demo Customer",
  "phone": "0901234567"
}

### Customer login
# @name customerLogin
POST {{ApiBase}}/auth/login
Content-Type: application/json

{
  "userName": "demo_customer",
  "password": "{{CustomerPassword}}"
}

### Customer profile
GET {{ApiBase}}/users/me
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### Update customer profile
PUT {{ApiBase}}/users/me
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}

{
  "fullName": "Demo Customer Updated",
  "phone": "0901234568"
}

### Get cart
GET {{ApiBase}}/cart
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### Add product to cart
# @name addToCart
POST {{ApiBase}}/cart/items
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}

{
  "productId": "{{ProductId}}",
  "quantity": 2
}

### Update cart item quantity
PUT {{ApiBase}}/cart/items/{{CartItemId}}
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}

{
  "quantity": 1
}

### Remove cart item
DELETE {{ApiBase}}/cart/items/{{CartItemId}}
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### Clear cart
DELETE {{ApiBase}}/cart
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### Add product to cart for checkout
POST {{ApiBase}}/cart/items
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}

{
  "productId": "{{ProductId}}",
  "quantity": 1
}

### Create promotion - Admin
# @name createPromotion
POST {{ApiBase}}/promotions
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "code": "WELCOME10",
  "type": 1,
  "value": 10,
  "minimumSubtotal": 500000,
  "maximumDiscountAmount": 100000,
  "startsAt": "2026-01-01T00:00:00Z",
  "endsAt": "2027-01-01T00:00:00Z",
  "usageLimit": 1000,
  "usageLimitPerCustomer": 1
}

### Quote current cart
# @name quoteOrder
POST {{ApiBase}}/orders/quote
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}

{
  "shippingMethod": 0,
  "promotionCode": "WELCOME10"
}

### Place order
# @name placeOrder
POST {{ApiBase}}/orders
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}
Idempotency-Key: {{IdempotencyKey}}

{
  "shippingAddress": "123 Demo Street, District 1, Ho Chi Minh City",
  "recipientName": "Demo Customer",
  "recipientPhone": "0901234567",
  "note": "Demo checkout from ECommerceBackend.http",
  "paymentMethod": 0,
  "shippingMethod": 0,
  "promotionCode": "WELCOME10",
  "expectedTotalAmount": {{quoteOrder.response.body.$.totalAmount}}
}

### My orders
GET {{ApiBase}}/orders/my?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### Initialize online payment for an order placed with paymentMethod = 1
# Requires Payments:Stripe:Enabled=true and Stripe test credentials.
POST {{ApiBase}}/payments/orders/{{OnlineOrderId}}/initialize
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### My order summaries
GET {{ApiBase}}/orders/my/summaries?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### Get order by id
GET {{ApiBase}}/orders/{{OrderId}}
Accept: application/json
Authorization: Bearer {{CustomerToken}}

### List all orders - Admin/Staff
GET {{ApiBase}}/orders?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{StaffToken}}

### List order summaries - Admin/Staff
GET {{ApiBase}}/orders/summaries?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{StaffToken}}

### Confirm order - Admin/Staff
PUT {{ApiBase}}/orders/{{OrderId}}/status
Content-Type: application/json
Authorization: Bearer {{StaffToken}}

{
  "status": 1,
  "note": "Đã xác nhận đơn hàng"
}

### Dispatch shipment - Admin/Staff
POST {{ApiBase}}/orders/{{OrderId}}/shipment/dispatch
Content-Type: application/json
Authorization: Bearer {{StaffToken}}

{
  "carrier": "Giao Hang Nhanh",
  "trackingNumber": "GHN-DEMO-001",
  "note": "Da ban giao cho don vi van chuyen"
}

### Mark shipment delivered - Admin/Staff
POST {{ApiBase}}/orders/{{OrderId}}/shipment/deliver
Content-Type: application/json
Authorization: Bearer {{StaffToken}}

{
  "note": "Da giao va thu COD"
}

### Request return - Customer
POST {{ApiBase}}/orders/{{OrderId}}/return-request
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}

{
  "reason": "San pham khong con phu hop nhu cau"
}

### Approve return - Admin/Staff
POST {{ApiBase}}/orders/{{OrderId}}/return-request/review
Content-Type: application/json
Authorization: Bearer {{StaffToken}}

{
  "decision": 0,
  "note": "Du dieu kien tra hang"
}

### Receive returned goods - Admin/Staff
POST {{ApiBase}}/orders/{{OrderId}}/return-request/receive
Content-Type: application/json
Authorization: Bearer {{StaffToken}}

{
  "inspectionNote": "Hang nguyen ven va du phu kien"
}

### Record COD refund - Admin/Staff
POST {{ApiBase}}/orders/{{OrderId}}/refund
Content-Type: application/json
Authorization: Bearer {{StaffToken}}

{
  "reference": "REFUND-DEMO-001",
  "note": "Da hoan tien"
}

### Low-stock products - Admin/Staff
GET {{ApiBase}}/inventory/low-stock?threshold=10&page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{StaffToken}}

### Product inventory history - Admin/Staff
GET {{ApiBase}}/inventory/products/{{ProductId}}/transactions?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{StaffToken}}

### Sales summary - Admin
GET {{ApiBase}}/reports/sales-summary?lowStockThreshold=10&topProductLimit=10
Accept: application/json
Authorization: Bearer {{AdminToken}}

### Outbox lỗi - Admin
GET {{ApiBase}}/operations/outbox/dead-letters?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{AdminToken}}

### Audit sự kiện - Admin
GET {{ApiBase}}/operations/audit-events?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{AdminToken}}

### Xem trước dọn dữ liệu vận hành - Admin
POST {{ApiBase}}/operations/data-retention
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "applyChanges": false,
  "maxBatchSize": 100
}

### Signed payment webhook sample (Development/Testing only)
# Accepted status values: paid, failed, cancelled, refunded.
# Signature input: {{PaymentEventId}} + "." + the exact raw JSON body below.
POST {{ApiBase}}/payments/webhooks/{{PaymentProvider}}
Content-Type: application/json
X-Payment-Event-Id: {{PaymentEventId}}
X-Payment-Signature: {{PaymentSignature}}

{
  "providerTransactionId": "replace-with-provider-transaction-id",
  "status": "paid",
  "amount": 100,
  "occurredAt": "2026-07-17T10:00:00Z"
}

### Checkout payment methods
GET {{ApiBase}}/payments/methods
Accept: application/json

### Refresh customer token
POST {{ApiBase}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{CustomerRefreshToken}}"
}

### Logout customer
POST {{ApiBase}}/auth/logout
Content-Type: application/json
Authorization: Bearer {{CustomerToken}}

{
  "refreshToken": "{{CustomerRefreshToken}}"
}

### Logout customer from all sessions
POST {{ApiBase}}/auth/logout-all
Authorization: Bearer {{CustomerToken}}

### Delete product image - Admin
DELETE {{ApiBase}}/products/{{ProductId}}/images/{{ProductImageId}}
Accept: application/json
Authorization: Bearer {{AdminToken}}

### Delete product - Admin
DELETE {{ApiBase}}/products/{{ProductId}}
Accept: application/json
Authorization: Bearer {{AdminToken}}

### Delete category - Admin
DELETE {{ApiBase}}/categories/{{CategoryId}}
Accept: application/json
Authorization: Bearer {{AdminToken}}
